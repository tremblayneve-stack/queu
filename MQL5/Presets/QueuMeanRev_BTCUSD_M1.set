; QueuBreakoutEA - BTCUSD M1, moteur RETOUR A LA MOYENNE multi-horizon.
;
; Achete le bas du canal M1 / vend le haut, mais seulement dans le sens
; des horizons lents (M3 et M5). Contre-tendance sur le bruit, dans le
; sens du regime.
;
; Geometrie retenue d'apres tools/meanrev_breakeven.py :
;   entree 2.0 dev / stop 3.0 dev / cible +0.5 dev au-dela de la droite.
;   Viser AU-DELA de la droite est le plus gros levier sur la tolerance
;   au cout : 0.80 -> 1.40 en cout/dev absorbable.
;
; Les filtres spread/ATR sont DESACTIVES a dessein : a M1 l'ATR est trop
; petit pour que ce ratio ait un sens. Le filtre de cout est ici
; InpMR_MaxBreakeven, qui compare le cout a la largeur du CANAL et refuse
; le trade si le taux de reussite requis depasse 60%.
;
; Trailing et break-even desactives : la cible est fixe, deplacer le stop
; rogne le gain sans rallonger la cible.
;
; A OPTIMISER EN PRIORITE : InpMR_Confirm (0 a 4), c'est le mode de
; confirmation des horizons lents et la question ouverte de ce setup.
InpEngine=3
InpMagic=770107
InpComment=QueuMR-BTC
InpTimeframe=1
InpSlippagePoints=100
InpShowPanel=true
InpChannelPeriod=24
InpATRPeriod=14
InpAllowLong=true
InpAllowShort=true
InpCloseOnOpposite=false
InpUseTrendFilter=false
InpTrendTF=16388
InpEmaFast=21
InpEmaSlow=50
InpUseADXFilter=false
InpADXPeriod=14
InpADXMin=22.0
InpMinATRPoints=0.0
InpMaxSpreadPoints=0.0
InpMaxSpreadATRRatio=0.0
InpRiskPercent=0.20
InpFixedLot=0.0
InpForceMinLot=false
InpMaxPositions=1
InpMaxDailyLossPct=3.0
InpMaxDailyProfitPct=0.0
InpCooldownBars=5
InpSL_ATR=2.5
InpTP_ATR=0.0
InpUseBreakEven=false
InpBE_ATR=1.2
InpBE_LockATR=0.10
InpUseTrailing=false
InpTrail_ATR=2.5
InpTrailStepPoints=100.0
InpMR_Period=60
InpMR_EntryDev=2.00
InpMR_StopDev=3.00
InpMR_TargetDev=0.50
InpMR_Confirm=1
InpMR_UseNested=false
InpMR_TF1=3
InpMR_TF2=5
InpMR_RequireOpposite=true
InpMR_ConfirmMinR2=0.25
InpMR_VoteThreshold=0.40
InpMR_MaxPosInChannel=0.50
InpMR_ConfirmMinSlope=0.50
InpMR_MaxBreakeven=60.0
InpMR_CostPoints=0.0
InpReg_BasePeriod=20
InpReg_RegimeFrom=1
InpReg_MinR2=0.35
InpReg_MinSlopeATR=1.00
InpReg_DevMode=0
InpReg_EntrySigma=1.00
InpReg_StopSigma=2.50
InpReg_RequireAboveLong=true
InpReg_ExitOnBreak=true
InpReg_ExitOnChannel=true
InpReg_ChannelMult=2.00
InpUseERFilter=false
InpERPeriod=20
InpERMin=0.35
InpBreakoutATR=0.15
InpUseDDThrottle=true
InpDD_ThrottleStart=5.0
InpDD_ThrottleFull=15.0
InpDD_MinMultiple=0.25
InpUseKelly=false
InpKellyFraction=0.25
InpKellyWindow=50
InpKellyMinSamples=30
InpKellyMinMultiple=0.25
InpKellyMaxMultiple=3.0
InpUsePartial=false
InpPartial_R=1.0
InpPartialPct=50.0
InpWriteJournal=true
InpTester_MinTrades=30
InpTester_Trials=0
InpTester_TrialsSD=0.0
InpTester_MaxDDPct=30.0
InpUseSession=false
InpSessionFrom=0
InpSessionTo=0
InpSkipWeekend=true
