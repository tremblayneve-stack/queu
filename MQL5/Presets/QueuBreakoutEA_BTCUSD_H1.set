; QueuBreakoutEA - preset de depart BTCUSD H1
; Point de depart pour l'optimisation, PAS un reglage valide en reel.
; Stops et marge de cassure elargis : le bruit intra-bougie du BTC fait
; sortir un stop a 2 ATR beaucoup plus souvent que sur l'or.
; Filtre de tendance en H4 : le H1 du BTC change de regime trop souvent.
InpMagic=770102
InpComment=QueuBrk-BTC
InpTimeframe=16385
InpSlippagePoints=100
InpShowPanel=true
InpChannelPeriod=24
InpATRPeriod=14
InpAllowLong=true
InpAllowShort=true
InpCloseOnOpposite=false
InpUseTrendFilter=true
InpTrendTF=16388
InpEmaFast=21
InpEmaSlow=50
InpUseADXFilter=true
InpADXPeriod=14
InpADXMin=22.0
InpMinATRPoints=0.0
InpMaxSpreadPoints=0.0
InpMaxSpreadATRRatio=0.15
InpRiskPercent=0.35
InpFixedLot=0.0
InpForceMinLot=false
InpMaxPositions=1
InpMaxDailyLossPct=3.0
InpMaxDailyProfitPct=0.0
InpCooldownBars=3
InpSL_ATR=2.5
InpTP_ATR=0.0
InpUseBreakEven=true
InpBE_ATR=1.2
InpBE_LockATR=0.10
InpUseTrailing=true
InpTrail_ATR=2.5
InpTrailStepPoints=100.0
InpUseERFilter=true
