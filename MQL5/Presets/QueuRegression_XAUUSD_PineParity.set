; QueuBreakoutEA - XAUUSD H1, parite visuelle avec le
; 'Linear Regression Channel' de LonesomeTheBlue (TradingView).
;
; InpReg_DevMode=2 (PINE) reproduit sa mesure de dispersion, qui vaut
;   dev = sqrt(SSres/n + pente^2)
; et non l'erreur-type : sa boucle evalue la droite avec un decalage
; d'une bougie, ce qui decale chaque residu de -pente. Les bandes sont
; donc plus larges que la dispersion reelle des que la pente est forte.
;
; InpReg_BasePeriod=25 -> echelons 25/50/100/200 : l'echelon 100 est la
; longueur par defaut de l'indicateur. InpReg_ChannelMult=2.0 = son devlen.
;
; A utiliser pour comparer l'EA a ce que tu vois sur TradingView.
; Pour trader, prefere InpReg_DevMode=0 (erreur-type).
InpEngine=1
InpMagic=770105
InpComment=QueuPine-XAU
InpTimeframe=16385
InpSlippagePoints=30
InpShowPanel=true
InpChannelPeriod=20
InpATRPeriod=14
InpAllowLong=true
InpAllowShort=true
InpCloseOnOpposite=false
InpUseTrendFilter=true
InpTrendTF=0
InpEmaFast=21
InpEmaSlow=50
InpUseADXFilter=true
InpADXPeriod=14
InpADXMin=20.0
InpMinATRPoints=0.0
InpMaxSpreadPoints=0.0
InpMaxSpreadATRRatio=0.12
InpRiskPercent=0.5
InpFixedLot=0.0
InpForceMinLot=false
InpMaxPositions=1
InpMaxDailyLossPct=3.0
InpMaxDailyProfitPct=0.0
InpCooldownBars=2
InpSL_ATR=2.0
InpTP_ATR=0.0
InpUseBreakEven=true
InpBE_ATR=1.0
InpBE_LockATR=0.10
InpUseTrailing=true
InpTrail_ATR=2.5
InpTrailStepPoints=20.0
InpReg_BasePeriod=25
InpReg_RegimeFrom=1
InpReg_MinR2=0.35
InpReg_MinSlopeATR=1.00
InpReg_DevMode=2
InpReg_EntrySigma=1.00
InpReg_StopSigma=2.50
InpReg_RequireAboveLong=true
InpReg_ExitOnBreak=true
InpReg_ExitOnChannel=true
InpReg_ChannelMult=2.00
InpUseERFilter=true
InpERPeriod=20
InpERMin=0.30
InpBreakoutATR=0.10
InpUseDDThrottle=true
InpDD_ThrottleStart=5.0
InpDD_ThrottleFull=15.0
InpDD_MinMultiple=0.25
InpUseKelly=false
InpKellyFraction=0.25
InpKellyWindow=50
InpKellyMinSamples=30
InpKellyMinMultiple=0.25
InpKellyMaxMultiple=3.0
InpUsePartial=false
InpPartial_R=1.0
InpPartialPct=50.0
InpWriteJournal=true
InpTester_MinTrades=30
InpTester_Trials=0
InpTester_TrialsSD=0.0
InpTester_MaxDDPct=30.0
InpUseSession=true
InpSessionFrom=7
InpSessionTo=20
InpSkipWeekend=false
