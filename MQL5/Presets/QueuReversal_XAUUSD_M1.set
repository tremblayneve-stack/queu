; XAUUSD M1 - moteur RETOURNEMENT SUR EPUISEMENT (contre-tendance).
;
; Les horizons lents M3/M5 sont CONTRAIRES au trade (canal rouge pour un
; achat) mais le prix stagne en haut de leur canal, voire en est sorti : la
; baisse n'arrive plus a produire son mouvement. Le canal M1 a deja bascule
; en vert. On entre sur le premier rebond confirme sur sa bande basse.
;
; A A/B TESTER EN PREMIER : InpRV_AcceptPosition.
;   Etre haut DANS un canal descendant est l'etat NORMAL de chaque
;   respiration d'une baisse saine : ce critere seul se declenche en
;   permanence. La SORTIE de canal (InpRV_AcceptBreakout) est bien plus
;   rare et bien plus significative. Compare les deux au journal avant de
;   garder la version permissive.
;
; Autres variantes a mesurer :
;   InpRV_ExhaustRequire  1 = un seul horizon epuise suffit, 2 = les deux
;   InpRV_RequireBounce   false = entree des la touche, sans confirmation
;   InpRV_RequireFlatten  true  = exige un ralentissement de la pente lente
;
; Setup de CONTRE-TENDANCE : taux de reussite structurellement plus faible
; qu'une continuation. Le filtre InpRV_MaxBreakeven compte double ici.
InpEngine=4
InpMagic=770108
InpComment=QueuRev-XAU
InpTimeframe=1
InpSlippagePoints=30
InpShowPanel=true
InpChannelPeriod=20
InpATRPeriod=14
InpAllowLong=true
InpAllowShort=true
InpCloseOnOpposite=false
InpUseTrendFilter=false
InpTrendTF=0
InpEmaFast=21
InpEmaSlow=50
InpUseADXFilter=false
InpADXPeriod=14
InpADXMin=20.0
InpMinATRPoints=0.0
InpMaxSpreadPoints=0.0
InpMaxSpreadATRRatio=0.0
InpRiskPercent=0.20
InpFixedLot=0.0
InpForceMinLot=false
InpMaxPositions=1
InpMaxDailyLossPct=3.0
InpMaxDailyProfitPct=0.0
InpCooldownBars=5
InpSL_ATR=2.0
InpTP_ATR=0.0
InpUseBreakEven=false
InpBE_ATR=1.0
InpBE_LockATR=0.10
InpUseTrailing=false
InpTrail_ATR=2.0
InpTrailStepPoints=20.0
InpMR_Period=50
InpMR_EntryDev=2.00
InpMR_StopDev=3.00
InpMR_TargetDev=0.50
InpMR_Confirm=1
InpMR_UseNested=false
InpMR_TF1=3
InpMR_TF2=5
InpMR_RequireOpposite=true
InpMR_ConfirmMinR2=0.25
InpMR_VoteThreshold=0.40
InpMR_MaxPosInChannel=0.50
InpMR_ConfirmMinSlope=0.50
InpMR_MaxBreakeven=60.0
InpMR_CostPoints=0.0
InpRV_Period=50
InpRV_TF1=3
InpRV_TF2=5
InpRV_UseNested=false
InpRV_SlowChannelMult=2.00
InpRV_MinSlowR2=0.20
InpRV_AcceptBreakout=true
InpRV_AcceptPosition=true
InpRV_SlowPosMin=0.75
InpRV_ExhaustRequire=1
InpRV_RequireFlatten=false
InpRV_RequireBounce=true
InpRV_BounceBars=3
InpRV_EntryDev=1.00
InpRV_StopDev=2.00
InpRV_TargetDev=1.00
InpRV_MaxBreakeven=60.0
InpRV_CostPoints=0.0
InpReg_BasePeriod=20
InpReg_RegimeFrom=1
InpReg_MinR2=0.35
InpReg_MinSlopeATR=1.00
InpReg_DevMode=0
InpReg_EntrySigma=1.00
InpReg_StopSigma=2.50
InpReg_RequireAboveLong=true
InpReg_ExitOnBreak=true
InpReg_ExitOnChannel=true
InpReg_ChannelMult=2.00
InpUseERFilter=false
InpERPeriod=20
InpERMin=0.30
InpBreakoutATR=0.10
InpUseDDThrottle=true
InpDD_ThrottleStart=5.0
InpDD_ThrottleFull=15.0
InpDD_MinMultiple=0.25
InpUseKelly=false
InpKellyFraction=0.25
InpKellyWindow=50
InpKellyMinSamples=30
InpKellyMinMultiple=0.25
InpKellyMaxMultiple=3.0
InpUsePartial=false
InpPartial_R=1.0
InpPartialPct=50.0
InpWriteJournal=true
InpTester_MinTrades=30
InpTester_Trials=0
InpTester_TrialsSD=0.0
InpTester_MaxDDPct=30.0
InpUseSession=true
InpSessionFrom=7
InpSessionTo=20
InpSkipWeekend=false
